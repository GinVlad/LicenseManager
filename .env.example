# Server
PORT=8080
ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/licensemanager?sslmode=disable

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Admin account (seeded on first boot if no admins exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# CORS — comma-separated frontend origins (leave empty to allow all in dev)
# CORS_ORIGINS=https://licenses.yourdomain.com
